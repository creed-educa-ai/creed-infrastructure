# Modelo do /opt/creed/.env da EC2. Os valores reais existem só lá — nunca no git.
# O compose lê o .env desta pasta, que na EC2 é um link para /opt/creed/.env.

# Elastic IP da EC2: endereço do certificado HTTPS e hostname do Keycloak.
PUBLIC_HOST=

# RDS — usuário das aplicações (creed_app), não o master.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=creed
POSTGRES_USER=creed_app
POSTGRES_PASSWORD=

# Admin TEMPORÁRIO do Keycloak — SÓ na primeira subida, e por isso comentado.
# Descomente e preencha as DUAS antes do primeiro `up`. Depois de criar um admin
# definitivo por pessoa no console e apagar este, apague as duas linhas de novo.
# Nunca deixe uma delas vazia: o Keycloak 26 recusa subir com nome sem senha.
# KC_BOOTSTRAP_ADMIN_USERNAME=admin-temporario
# KC_BOOTSTRAP_ADMIN_PASSWORD=

# Segredo do client creed-backend. O mesmo valor serve ao Keycloak (vira o
# segredo do client no realm) e ao back (que o usa para pedir token).
# Gere com: openssl rand -hex 32
KEYCLOAK_CLIENT_SECRET=

# Domínio do front no Amplify (https://...amplifyapp.com), quando ele existir.
# Vários? Separe por vírgula.
CORS_ORIGINS=

# Endereço do front no Amplify (https://...amplifyapp.com), SEM barra no fim: o back
# monta <FRONTEND_URL>/login no link "voltar" do convite, e o realm aceita
# <FRONTEND_URL>/* como redirect. Mudou? Rode o realm/aplicar-ajustes.sh (README).
FRONTEND_URL=

# Validade do link do convite, em segundos. Fora do .env vale o padrão do back,
# 72 h. Só descomente para trocar.
# KEYCLOAK_INVITE_LIFESPAN_SECONDS=259200

# E-mail do convite e da redefinição de senha: o Keycloak manda pelo SMTP do Gmail
# do projeto (adendo de 2026-10-27 do ADR-0006). Mudou qualquer SMTP_*? Rode o
# realm/aplicar-ajustes.sh (README, "E-mail (SMTP)").
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER e SMTP_FROM são o MESMO endereço, o Gmail do projeto: o Google reescreve
# qualquer outro remetente.
SMTP_USER=
SMTP_FROM=
# Senha de app do Google, com o dono da conta (Enzo); nunca no git e, pelo adendo do
# ADR-0006, fora do Parameter Store. Não é a senha da conta. Os 16 caracteres, sem
# os espaços com que o Google a mostra.
SMTP_PASSWORD=

# Commit da imagem do back que está no ar. Quem escreve é o deploy.sh — não edite.
# BACK_TAG=

# Chave que criptografa as credenciais salvas no N8N. Gere UMA vez e nunca troque:
# trocada, as credenciais já salvas ficam ilegíveis. Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Senha compartilhada que o Caddy pede antes de mostrar o editor do N8N.
# O HASH (não a senha) vai aqui, ENTRE ASPAS SIMPLES: ele tem "$", que sem as
# aspas o compose tentaria ler como variável. Gere com:
#   docker run --rm caddy:2.11 caddy hash-password --plaintext 'a-senha'
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_HASH=''
