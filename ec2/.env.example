# Modelo do /opt/creed/.env da EC2. Os valores reais existem só lá — nunca no git.
# O compose lê o .env desta pasta, que na EC2 é um link para /opt/creed/.env.

# Elastic IP da EC2: endereço do certificado HTTPS e hostname do Keycloak.
PUBLIC_HOST=

# RDS — usuário das aplicações (creed_app), não o master.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=creed
POSTGRES_USER=creed_app
POSTGRES_PASSWORD=

# Admin do console do Keycloak (acesso só por túnel SSH).
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Segredo do client creed-backend. O mesmo valor serve ao Keycloak (vira o
# segredo do client no realm) e ao back (que o usa para pedir token).
# Gere com: openssl rand -hex 32
KEYCLOAK_CLIENT_SECRET=
