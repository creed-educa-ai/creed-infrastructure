# Porta de entrada da EC2 (ADR-0007): HTTPS e divisão do tráfego por caminho.
# PUBLIC_HOST é o Elastic IP, vindo do .env.

{
	# Quem acessa por IP não informa a qual site quer chegar (não há SNI).
	# Isto diz ao Caddy qual certificado apresentar nesse caso.
	default_sni {$PUBLIC_HOST}
}

# Para IP, o Let's Encrypt só emite no perfil de ~6 dias. O Caddy renova sozinho.
# Os dois endereços abaixo são o mesmo IP: usam o mesmo certificado.
(certificado_do_ip) {
	tls {
		issuer acme {
			profile shortlived
		}
	}
}

{$PUBLIC_HOST} {
	import certificado_do_ip

	# Console e Admin API do Keycloak não saem para a internet. O console é
	# acessado por túnel SSH, e o back fala com a Admin API pela rede interna do
	# compose, sem passar por aqui. Vem antes do /auth/* por ser caminho mais longo.
	handle /auth/admin* {
		respond 404
	}

	# O realm master guarda os admins do próprio Keycloak. Aberto, ele aceita
	# tentativa de senha desses admins vinda de qualquer lugar. Ninguém de fora
	# precisa dele: o master tem Frontend URL http://localhost:18080/auth, então o
	# login do console vai pelo túnel. Sem isso, o console quebra (ver README).
	handle /auth/realms/master* {
		respond 404
	}

	# Páginas do realm: é aqui que abre o link do convite de primeiro acesso
	# (ADR-0006, P-012).
	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	# API do back. O caminho chega inteiro (/api/v1/...), que é como o back espera.
	handle /api/* {
		reverse_proxy back:8000
	}

	handle {
		respond "CREED ok" 200
	}
}

# Editor do N8N, para o time montar os workflows (CREED-284). Porta própria e não
# um caminho como /n8n: o editor do N8N tem problemas conhecidos dentro de caminho.
#
# Duas camadas: a senha compartilhada abaixo esconde a tela do N8N dos robôs que
# varrem a internet; depois dela vem o login do próprio N8N, um usuário por pessoa.
# O back NÃO passa por aqui: chama o N8N pela rede interna (http://n8n:5678).
{$PUBLIC_HOST}:5679 {
	import certificado_do_ip

	basic_auth {
		{$N8N_BASIC_AUTH_USER} {$N8N_BASIC_AUTH_HASH}
	}

	reverse_proxy n8n:5678
}
